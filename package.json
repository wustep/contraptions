{
  "name": "contraptions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A generator for grids of tiny animated machines.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check && npm run check:rube && npm run check:builder && npm run check:shows && npm run check:premiere && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "new": "node scripts/new-contraption.mjs",
    "check": "esbuild scripts/check.ts --bundle --platform=node --format=cjs --external:p5 --log-level=error --outfile=node_modules/.cache/contraptions-check.cjs && node node_modules/.cache/contraptions-check.cjs",
    "check:rube": "esbuild apps/rube/check.ts --bundle --platform=node --format=cjs --external:p5 --log-level=error --outfile=node_modules/.cache/rube-check.cjs && node node_modules/.cache/rube-check.cjs",
    "check:builder": "esbuild apps/rube/check-builder.ts --bundle --platform=node --format=cjs --external:p5 --log-level=error --outfile=node_modules/.cache/rube-check-builder.cjs && node node_modules/.cache/rube-check-builder.cjs",
    "check:shows": "esbuild apps/rube/check-shows.ts --bundle --platform=node --format=cjs --external:p5 --loader:.mp3=file --loader:.ogg=file --loader:.wav=file --log-level=error --outfile=node_modules/.cache/rube-check-shows.cjs && node node_modules/.cache/rube-check-shows.cjs",
    "check:premiere": "esbuild scripts/check-premiere-preview.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/premiere-check.mjs && node node_modules/.cache/premiere-check.mjs",
    "generate:premiere": "esbuild scripts/generate-premiere-show.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/generate-premiere-show.mjs && node node_modules/.cache/generate-premiere-show.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "p5": "^1.11.11"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/p5": "^1.7.6",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
