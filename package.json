{
  "name": "contraptions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A generator for grids of tiny animated machines.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "new": "node scripts/new-contraption.mjs",
    "check": "esbuild scripts/check.ts --bundle --platform=node --format=cjs --external:p5 --log-level=error --outfile=node_modules/.cache/contraptions-check.cjs && node node_modules/.cache/contraptions-check.cjs"
  },
  "dependencies": {
    "p5": "^1.11.11"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/p5": "^1.7.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
