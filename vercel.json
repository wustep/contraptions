{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:site",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "redirects": [
    { "source": "/", "destination": "/machine/", "permanent": false },
    { "source": "/rube{/}?", "destination": "/machine/", "permanent": false },
    { "source": "/sandbox{/}?", "destination": "/explorations/", "permanent": false }
  ]
}
