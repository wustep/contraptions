{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:site",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "redirects": [
    { "source": "/games/extremely-normal-gifts", "destination": "/games/extremely-normal-gifts/", "permanent": false },
    { "source": "/", "destination": "/machine/", "permanent": false },
    { "source": "/rube{/}?", "destination": "/machine/", "permanent": false },
    { "source": "/sandbox{/}?", "destination": "/explorations/", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
